{
  "name": "pilot",
  "productName": "Pilot",
  "version": "0.3.1",
  "private": true,
  "description": "Desktop AI agent app built on pi (earendil-works/pi)",
  "homepage": "https://github.com/Murmureeee/Pilot",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:win": "pnpm build && node scripts/package-win.mjs",
    "package:linux": "pnpm build && node scripts/package-linux.mjs",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/restore-electron.mjs",
    "format": "oxfmt --write src tests",
    "lint": "oxlint src tests && oxfmt --check src tests",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "knip": "knip",
    "test": "vitest",
    "ci": "pnpm lint && pnpm typecheck && pnpm knip && pnpm test --run"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@earendil-works/pi-agent-core": "^1.5.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-mcp": "1.5.2",
    "@earendil-works/pi-schema": "^1.5.2",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "electron-updater": "6.8.11",
    "i18next": "27.2.1",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "18.0.2",
    "shiki": "^4.6.0",
    "smol-toml": "1.9.1",
    "streamdown": "^2.8.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "knip": "^6.45.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
